{
	"folders": [
		{
			"name": "root",
			"path": "."
		},
		{
			"name": "api",
			"path": "api"
		},
		{
			"name": "api-go",
			"path": "api-go"
		},
		{
			"name": "frontend",
			"path": "frontend"
		}
	],
	"settings": {},
	"tasks": {
		"version": "2.0.0",
		"tasks": [
			{
				"label": "build_be",
				"type": "shell",
				"command": "dotnet",
				"args": [
					"build",
					"${workspaceFolder:api}/SpendingTracker.Api/SpendingTracker.Api.csproj"
				],
				"group": {
					"kind": "build",
					"isDefault": true
				},
				"problemMatcher": [
					"$msCompile"
				]
			},
			{
				"label": "fe_dev",
				"type": "shell",
				"command": "npm",
				"args": [
					"run",
					"dev"
				],
				"options": {
					"cwd": "${workspaceFolder:frontend}"
				},
				"group": {
					"kind": "build",
					"isDefault": false
				},
				"problemMatcher": []
			}
		]
	},
	"launch": {
		"version": "0.2.0",
		"configurations": [
			{
				"name": "api-go",
				"type": "go",
				"request": "launch",
				"mode": "auto",
				"program": "${workspaceFolder:api-go}",
				"env": {
					"ALLOW_ORIGINS": "http://localhost:5173",
					"PORT": "7004",
					"DB_FILE_PATH": "${workspaceFolder:root}/spending-tracker.db"
				},
				"args": []
			},
			{
				"name": "API",
				"type": "coreclr",
				"request": "launch",
				"preLaunchTask": "build_be",
				"program": "${workspaceFolder:api}/SpendingTracker.Api/bin/Debug/net9.0/SpendingTracker.Api.dll",
				"args": [],
				"cwd": "${workspaceFolder:api}/SpendingTracker.Api",
				"stopAtEntry": false,
				// "serverReadyAction": {
				//     "action": "openExternally",
				//     "pattern": "\\bNow listening on:\\s+(https?://\\S+)",
				//     "uriFormat": "%s/swagger/index.html"
				// },
				"env": {
					"ASPNETCORE_ENVIRONMENT": "Development"
				},
				"console": "internalConsole"
			}
		],
		"compounds": []
	},
	"extensions": {
		"recommendations": [
			"golang.go",
			"dbaeumer.vscode-eslint",
			"esbenp.prettier-vscode",
		]
	}
}