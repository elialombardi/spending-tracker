# Backend configuration. WARNING: this file is currently tracked by Git.
# Do not commit real credentials. Use ignored .env.local or injected secrets.
# Replace the existing placeholders and fill the required secrets before running.
#
# Load into the process explicitly, from api-go:
#   set -a; . ./.env; set +a; go run .
# Or pass this file to your process manager / container with --env-file.
# The main command only explicitly loads .env.local when APP_ENV=development.
# If using that mode, export APP_ENV=development before startup and provide
# .env.local as well. The auth-only cmd/api entry point does not load env files.

# Application / HTTP server
APP_ENV="production"
APP_VERSION="local"
PORT="7004"
STATIC_DIR="./public"

# Required: PostgreSQL connection. Existing value preserved; replace placeholders.
SPENDING_TRACKER_CONNECTION_STRING="postgresql://user:pass@host:port/db?TimeZone=UTC"

# Seeded users (full API only).
# REQUIRED: choose unique, strong passwords. Empty values use insecure dev defaults.
# Startup creates these accounts or resets their passwords to these values.
SPENDING_TRACKER_ADMIN_USERNAME="admin"
SPENDING_TRACKER_ADMIN_PASSWORD=""
SPENDING_TRACKER_WRITER_USERNAME="user"
SPENDING_TRACKER_WRITER_PASSWORD=""

# JWT authentication
# REQUIRED: use a cryptographically random secret of at least 32 bytes.
# Never use the built-in development fallback in a deployed application.
JWT_SIGNING_KEY=""
JWT_ISSUER="SpendingTracker.Api"
JWT_AUDIENCE="SpendingTracker.Client"
# Password-login JWT lifetime only; biometric JWTs always expire after 15 minutes.
JWT_TOKEN_LIFETIME_MINUTES="480"

# Biometric authentication (full API opt-in; cmd/api always enables it).
# Set true only after configuring JWT_SIGNING_KEY.
BIOMETRIC_AUTH_ENABLED="false"
# Optional: redis://user:password@host:6379/0 or rediss://... for TLS.
# Empty or unavailable at startup uses process-local memory (single instance only).
REDIS_URL=""

# Background schedules: explicit false keeps unconfigured integrations idle.
# When omitted, boxing/search default true outside development;
# YouTube defaults true in development. Manual API operations remain available.
BOXING_SYNC_ENABLED="false"
YOUTUBE_SYNC_ENABLED="false"
SEARCH_SYNC_ENABLED="false"

# Boxing / Pinnacle: configure both before enabling the boxing schedule.
PINNACLE_BASE_URL=""
PINNACLE_API_KEY=""
# Legacy value preserved. Current code does NOT read this variable;
# put the actual API key in PINNACLE_API_KEY instead.
SPENDING_TRACKER_PINNAPI="XXX"

# YouTube: existing API-key value preserved; replace it if it is a placeholder.
YOUTUBE_API_KEY="xXX"
# Optional OAuth credentials for subscription access. Set together as needed.
# Redirect URL must exactly match the URI registered with Google.
YOUTUBE_CLIENT_ID=""
YOUTUBE_CLIENT_SECRET=""
YOUTUBE_REDIRECT_URL=""

# Optional server-side Geoapify location search.
GEOAPIFY_API_KEY=""

# Optional eBay marketplace integration: set BOTH or leave BOTH empty.
# Configure production Browse API credentials before enabling marketplace sync.
EBAY_CLIENT_ID=""
EBAY_CLIENT_SECRET=""

# Optional Telegram alerts: set BOTH or leave BOTH empty.
# TELEGRAM_CHAT_ID must be a nonzero numeric chat ID (negative group IDs allowed).
# This destination is shared by the app, not scoped to an individual user.
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""

# Legacy SQLite helper only; the running API uses PostgreSQL above.
SPENDING_TRACKER_DB_PATH="App_Data/spending-tracker.db"

# Frontend settings belong in frontend/.env.local, NOT this backend file.
# Vite exposes VITE_* values to the browser: never put server secrets there.
# Uncomment/copy the relevant lines into frontend/.env.local:
# VITE_API_BASE="http://localhost:7004"
# VITE_APP_VERSION="local"
# VITE_PLACE_SEARCH_PROVIDER="nominatim"
# VITE_GEOAPIFY_API_KEY=""
# Development auto-login only; these values are exposed in the client bundle.
# VITE_AUTH_USERNAME="admin"
# VITE_AUTH_PASSWORD=""
# Older frontend aliases (prefer VITE_*):
# REACT_APP_API_BASE="http://localhost:7004"
# REACT_APP_PLACE_SEARCH_PROVIDER="nominatim"
# REACT_APP_GEOAPIFY_API_KEY=""
# REACT_APP_AUTH_USERNAME="admin"
# REACT_APP_AUTH_PASSWORD=""
# NODE_ENV is normally managed by Vite; do not override it here.

# Frontend-only Docker Compose settings (frontend/compose.yaml):
# APP_PORT="8080"
# API_URL="http://localhost:7004"
# VITE_PLACE_SEARCH_PROVIDER="nominatim"
# VITE_GEOAPIFY_API_KEY=""

# TLS_CERT / TLS_KEY are NOT active settings: backend TLS code is commented out.
# Terminate HTTPS at a reverse proxy instead.