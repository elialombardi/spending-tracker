{
  "manifest_version": 3,
  "name": "Spending Tracker Bookmarks",
  "version": "1.0.0",
  "description": "Save the current page to a Bookmarks folder in Spending Tracker.",
  "minimum_chrome_version": "120",
  "permissions": ["activeTab", "storage"],
  "optional_host_permissions": ["https://*/*", "http://localhost/*", "http://127.0.0.1/*", "http://[::1]/*"],
  "action": {
    "default_title": "Save to Spending Tracker",
    "default_popup": "popup.html"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; base-uri 'none'"
  }
}
