@host = http://localhost:5163
@transactionId = 00000000-0000-0000-0000-000000000000

POST {{host}}/api/imports/poste-italiane
Content-Type: multipart/form-data; boundary=SpendingBoundary
Accept: application/json

--SpendingBoundary
Content-Disposition: form-data; name="file"; filename="ListaMovimenti.xlsx"
Content-Type: application/vnd.openxmlformats-officedocument.spreadsheetml.sheet

< ./../ListaMovimenti.xlsx
--SpendingBoundary--

###

GET {{host}}/api/transactions/summary?from=2026-05-01&to=2026-06-30
Accept: application/json

###

GET {{host}}/api/transactions?needsReview=true
Accept: application/json

###

GET {{host}}/api/reports/cycles
Accept: application/json

###

GET {{host}}/api/categories/cycle-income
Accept: application/json

###

PUT {{host}}/api/categories/cycle-income
Content-Type: application/json

{
	"categories": ["Salary", "Pension"]
}

###

GET {{host}}/api/reports/cycle?cycleStart=2026-05-27
Accept: application/json

###

GET {{host}}/api/reports/cycle/export?cycleStart=2026-05-27&format=csv
Accept: text/csv

###

GET {{host}}/api/reports/cycle/export?cycleStart=2026-05-27&format=xlsx
Accept: application/vnd.openxmlformats-officedocument.spreadsheetml.sheet

###

POST {{host}}/api/transactions/{{transactionId}}/categorize
Content-Type: application/json

{
	"category": "Groceries",
	"saveRule": true,
	"ruleBehavior": "AutoApply"
}

###

POST {{host}}/api/transactions/{{transactionId}}/categorize
Content-Type: application/json

{
	"category": "Shopping",
	"saveRule": true,
	"ruleBehavior": "AlwaysReview"
}

###
